{
  "name": "meetingstone-chat",
  "productName": "MeetingStone Chat",
  "version": "0.2.0",
  "description": "集合石 · 魔兽风透明聊天悬浮窗（Electron）—— 局域网 + 公共中继加密房间",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/roomStack.ts --bundle --platform=node --format=cjs --outfile=room-stack.cjs --external:electron",
    "start": "npm run build && electron .",
    "selftest": "npm run build && electron . --selftest",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@noble/secp256k1": "3.2.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "40.9.3",
    "esbuild": "0.28.2",
    "electron-builder": "26.15.3"
  },
  "author": "li2810081",
  "build": {
    "appId": "com.meetingstone.chat",
    "productName": "MeetingStone Chat",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "room-stack.cjs",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "集合石聊天",
      "artifactName": "MeetingStone-Chat-Setup-${version}.exe"
    }
  }
}